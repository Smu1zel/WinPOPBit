<?xml version="1.0" encoding="utf-8"?>
<BadBlobs>
    <!-- Windows NT Kernel: In-place NX (No-Execute) requirement bypass patch -->
    <Blob id="ntoskrnl" action="patch" patcher="kernel_nx" enabled="true">
        <Target>Windows/System32/ntoskrnl.exe</Target>
        <Description>Windows 10's x86 NT Kernel (Bypasses NX / No-Execute bit requirement)</Description>
        <Options>
            <!-- Bypasses KF_NX (0x20000000) check in KiInitializeProcessor -->
            <Option name="patch_nx" value="true" />
            <!-- Optional KeBugCheckEx infinite loop for QEMU GDB debugging -->
            <Option name="debug_loop" value="false" />
        </Options>
    </Blob>

    <!-- Windows Boot Loader: In-place NX bypass and EFER.NXE safety patch -->
    <Blob id="winload_boot_exe" action="patch" patcher="winload_nx" enabled="true">
        <Target>Windows/System32/boot/winload.exe</Target>
        <Description>Windows Boot Loader Legacy BIOS Boot (Bypasses NX initialization and EFER.NXE fault)</Description>
        <Options>
            <Option name="patch_nx" value="true" />
            <Option name="patch_msr_fallback" value="true" />
            <Option name="patch_ci_filter" value="true" />
        </Options>
    </Blob>

    <Blob id="winload_sys32_exe" action="patch" patcher="winload_nx" enabled="true">
        <Target>Windows/System32/winload.exe</Target>
        <Description>Windows Boot Loader Legacy BIOS System32 (Bypasses NX initialization and EFER.NXE fault)</Description>
        <Options>
            <Option name="patch_nx" value="true" />
            <Option name="patch_msr_fallback" value="true" />
            <Option name="patch_ci_filter" value="true" />
        </Options>
    </Blob>

    <!-- Windows Boot Loader (winresume): In-place NX bypass and EFER.NXE safety patch -->
    <!-- winresume happens to share a lot of code with winload, so not patching this -->
    <!-- breaks booting if Fast Startup is enabled, or if the user ever hibernates. -->
    <Blob id="winresume_boot_exe" action="patch" patcher="winload_nx" enabled="true">
        <Target>Windows/System32/boot/winresume.exe</Target>
        <Description>Windows Boot Loader (winresume copy) Legacy BIOS Boot (Bypasses NX initialization and EFER.NXE fault)</Description>
        <Options>
            <Option name="patch_nx" value="true" />
            <Option name="patch_msr_fallback" value="true" />
            <!-- winresume doesn't verify anything, for some reason. -->
            <Option name="patch_ci_filter" value="false" />
        </Options>
    </Blob>

    <Blob id="winresume_sys32_exe" action="patch" patcher="winload_nx" enabled="true">
        <Target>Windows/System32/winresume.exe</Target>
        <Description>Windows Boot Loader (winresume copy) Legacy BIOS System32 (Bypasses NX initialization and EFER.NXE fault)</Description>
        <Options>
            <Option name="patch_nx" value="true" />
            <Option name="patch_msr_fallback" value="true" />
            <Option name="patch_ci_filter" value="false" />
        </Options>
    </Blob>

    <!-- Windows Hardware Abstraction Layer (HAL): In-place NX bypass and PTE XD bit 63 suppression -->
    <Blob id="hal" action="patch" patcher="hal_nx" enabled="true">
        <Target>Windows/System32/hal.dll</Target>
        <Description>Windows Hardware Abstraction Layer (Bypasses AP NX trampoline and PTE bit 63 fault)</Description>
        <Options>
            <Option name="patch_pte" value="true" />
            <Option name="patch_ap_trampoline" value="true" />
        </Options>
    </Blob>

    <Blob id="halmacpi" action="patch" patcher="hal_nx" enabled="true">
        <Target>Windows/System32/halmacpi.dll</Target>
        <Description>Windows ACPI HAL (Bypasses AP NX trampoline and PTE bit 63 fault)</Description>
        <Options>
            <Option name="patch_pte" value="true" />
            <Option name="patch_ap_trampoline" value="true" />
        </Options>
    </Blob>

    <!-- BCD Store Configuration -->
    <!-- Commands executed against both BIOS (boot\bcd) and UEFI (efi\microsoft\boot\bcd) stores via bcdedit -->
    <Bcd>
        <Command>/set {default} nx AlwaysOff</Command>
        <Command>/set {default} nointegritychecks Yes</Command>
        <!---
        <Command>/set {default} debug on</Command>
        <Command>/dbgsettings serial debugport:1 baudrate:115200</Command>
        <Command>/set {default} debugtype serial</Command>
        <Command>/set {default} debugport 1</Command>
        <Command>/set {default} baudrate 115200</Command>
        <Command>/set {bootmgr} bootdebug on</Command>
        <Command>/set {default} bootdebug on</Command>
        -->
        <Command>/set {default} testsigning Yes</Command>
        <Command>/set {default} recoveryenabled Yes</Command>
        <Command>/set {default} advancedoptions Yes</Command>
        <Command>/set {default} bootmenupolicy legacy</Command>
    </Bcd>
</BadBlobs>
